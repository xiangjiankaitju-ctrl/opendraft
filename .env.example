# OpenDraft Configuration
# Copy this file to .env and add your API keys

# Unified LLM provider selection
# Supported: gemini | openai | claude | groq | generic

#决定是否在校验环节使用性能更强的模型
USE_PRO_FOR_VALIDATION=False
pro_model_name = "gpt-4o-pro"  # Set the Pro model name you want to use for validation (e.g., "gpt-4o-pro")
# Set to True to validate each section separately, False to validate the entire draft at once
validate_per_section = True
# Set to True to enable fact-checking during validation  
enable_factchecking = True  
# Provider model names

#速率限制
ENABLE_SEMANTIC_SCHOLAR = True

# Generic endpoint mode (provider-agnostic): any OpenAI-compatible endpoint
LLM_BASE_URL=https://your-llm-endpoint.example.com/v1
LLM_API_KEY=your-llm-key
LLM_MODEL=your-model-name
LLM_API_PATH=/chat/completions

