# OpenDraft Configuration
# Copy this file to .env and add your API keys

# Unified LLM provider selection
# Supported: gemini | openai | claude | groq | generic
AI_PROVIDER=gemini

# Provider model names
GEMINI_MODEL=gemini-3-pro-preview
OPENAI_MODEL=gpt-4.1-nano
CLAUDE_MODEL=claude-3-5-sonnet-latest
GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# Generic endpoint mode (provider-agnostic): any OpenAI-compatible endpoint
# If both LLM_BASE_URL and LLM_API_KEY are set, system uses this mode first.
# LLM_BASE_URL=https://your-llm-endpoint.example.com/v1
# LLM_API_KEY=your-llm-key
# LLM_MODEL=your-model-name
# LLM_API_PATH=/chat/completions

# Provider API keys (set the one matching AI_PROVIDER)
GOOGLE_API_KEY=your-gemini-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-claude-api-key
# GROQ_API_KEY=your-groq-api-key

# Optional: Fallback Gemini API keys for rate limit resilience
# GOOGLE_API_KEY_FALLBACK=your-fallback-key
# GOOGLE_API_KEY_FALLBACK_2=your-second-fallback-key
# GOOGLE_API_KEY_FALLBACK_3=your-third-fallback-key
